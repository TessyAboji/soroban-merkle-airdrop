{
  "name": "@soroban-merkle-airdrop/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "CLI for creating and managing Merkle airdrops on Stellar",
  "bin": {
    "merkle-airdrop": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "vitest run",
    "lint": "pnpm exec eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@soroban-merkle-airdrop/sdk": "workspace:*",
    "@stellar/stellar-sdk": "13.1.0",
    "commander": "15.0.0",
    "chalk": "5.3.0",
    "ora": "8.0.1",
    "dotenv": "18.0.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "5.4.5",
    "vitest": "5.0.5",
    "eslint": "8.57.0",
    "supports-color": "7.2.0",
    "@typescript-eslint/parser": "7.13.0",
    "@typescript-eslint/eslint-plugin": "7.13.0"
  },
  "engines": { "node": ">=20" }
}
